<?xml version="1.0" encoding="utf-8"?>
<network-security-config xmlns:tools="http://schemas.android.com/tools" tools:ignore="AcceptsUserCertificates">
    <base-config>
        <trust-anchors>
            <!-- Managed devices install their own CA for self-hosted servers -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
