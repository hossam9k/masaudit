<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name=".AutofillCallbackActivity" android:exported="true" />
        <receiver android:name=".Wipe" android:exported="true">
            <intent-filter><action android:name="com.example.WIPE_DATA" /></intent-filter>
        </receiver>
        <!-- Not a public contract: a lookalike of the UnifiedPush prefix. -->
        <receiver android:name=".FakePush" android:exported="true">
            <intent-filter><action android:name="org.unifiedpush.android.connectorx.MESSAGE" /></intent-filter>
        </receiver>
    </application>
</manifest>
