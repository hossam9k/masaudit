<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- A media session service must be exported for Android Auto; the custom action adds nothing. -->
        <service android:name=".Playback" android:exported="true">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="com.example.PLAYBACK" />
            </intent-filter>
        </service>
        <!-- PanicKit: other apps are meant to send this. -->
        <receiver android:name=".Panic" android:exported="true">
            <intent-filter><action android:name="info.guardianproject.panic.action.TRIGGER" /></intent-filter>
        </receiver>
        <activity android:name=".PanicResponderActivity" android:exported="true">
            <intent-filter>
                <action android:name="info.guardianproject.panic.action.TRIGGER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Vendor boot broadcasts. -->
        <receiver android:name=".Boot" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        <!-- UnifiedPush: the distributor app delivers messages. -->
        <receiver android:name=".Push" android:exported="true">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.MESSAGE" />
                <action android:name="org.unifiedpush.android.connector.UNREGISTERED" />
                <action android:name="org.unifiedpush.android.connector.NEW_ENDPOINT" />
                <action android:name="org.unifiedpush.android.connector.REGISTRATION_FAILED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
