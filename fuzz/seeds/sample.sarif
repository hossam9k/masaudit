{
 "version": "2.1.0",
 "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "Android Lint",
     "rules": [
      {
       "id": "InsecureBaseConfiguration",
       "shortDescription": {
        "text": "Insecure base"
       },
       "defaultConfiguration": {
        "level": "warning"
       },
       "help": {
        "text": "Use HTTPS."
       }
      }
     ]
    }
   },
   "originalUriBaseIds": {
    "SRCROOT": {
     "uri": "file:///home/runner/work/app/app/"
    }
   },
   "results": [
    {
     "ruleId": "InsecureBaseConfiguration",
     "ruleIndex": 0,
     "level": "warning",
     "message": {
      "text": "Insecure base"
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "app/src/main/res/xml/nsc.xml",
         "uriBaseId": "SRCROOT"
        },
        "region": {
         "startLine": 3,
         "snippet": {
          "text": "<base-config cleartextTrafficPermitted=\"true\">"
         }
        }
       }
      }
     ]
    },
    {
     "ruleId": "custom/rule",
     "level": "error",
     "message": {
      "text": "m"
     },
     "suppressions": [
      {
       "kind": "inSource"
      }
     ],
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "../outside.kt"
        },
        "region": {
         "startLine": 1
        }
       }
      }
     ]
    },
    {
     "rule": {
      "id": "x"
     },
     "kind": "pass",
     "level": "none",
     "message": "plain"
    }
   ]
  },
  {
   "tool": {
    "driver": {
     "name": "zizmor"
    }
   },
   "results": [
    {
     "ruleId": "zizmor/unpinned-uses",
     "message": {
      "text": "unpinned"
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "file:///tmp/x/.github/workflows/ci.yml"
        },
        "region": {
         "startLine": 9
        }
       }
      }
     ]
    }
   ]
  }
 ]
}
